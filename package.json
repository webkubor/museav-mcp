{
  "name": "museav-mcp",
  "version": "2.2.0",
  "description": "MCP server — CS 系统（CortexOS）的 MCP：把个人工具链上各开源项目的 CLI 能力串成一张网，按「能力分组」组织（出图/视频、本地看图、对比度门禁、Markdown 排版…），装了哪个 CLI 就自动长出哪组工具。27 个工具，能力在 CLI 里，MCP 只做串联。",
  "type": "module",
  "bin": {
    "museav-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build && node scripts/prepublish-gate.mjs && node scripts/readme-gate.mjs",
    "test": "node test-mcp.mjs",
    "pub": "cs kyvault run --env TOKEN=secret://npm/webkubor-publish -- sh -c 'npm publish --access public --//registry.npmjs.org/:_authToken=\"$TOKEN\"'",
    "notify": "node ../notify.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/museav-mcp.git"
  },
  "homepage": "https://docs.museav.top/cli/mcp",
  "bugs": {
    "url": "https://github.com/webkubor/museav-mcp/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cortexos",
    "cs",
    "agent-toolbox",
    "ai-agent",
    "museav",
    "image-generation",
    "image-editing",
    "vlm",
    "mlx",
    "contrast-guard",
    "facet",
    "skillhub",
    "小红书",
    "出图"
  ],
  "files": [
    "dist/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
